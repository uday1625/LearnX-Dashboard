    {
      "id": "b2",
      "title": "Infinite Loop in Binary Search",
      "domain": "dsa",
      "difficulty": "Medium",
      "bountyXP": 150,
      "description": "This binary search algorithm gets stuck in an infinite loop for certain target values. Find the line causing the algorithm to hang.",
      "codeSnippet": [
        "function binarySearch(arr, target) {",
        "  let left = 0;",
        "  let right = arr.length - 1;",
        "  while (left <= right) {",
        "    let mid = Math.floor((left + right) / 2);",
        "    if (arr[mid] === target) return mid;",
        "    if (arr[mid] < target) left = mid;",
        "    else right = mid - 1;",
        "  }",
        "  return -1;",
        "}"
      ],
      "correctLine": 7,
      "correctCategory": "Infinite Loop",
      "hint": "Check line 7: If left is not incremented past mid when target is larger, left and right will never meet, causing an infinite loop.",
      "claimed": false
    },
    {
